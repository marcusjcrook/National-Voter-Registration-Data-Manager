{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "vs2026-x64",
            "displayName": "Visual Studio 2026 x64",
            "generator": "Visual Studio 18 2026",
            "architecture": "x64",
            "toolset": "host=x64",
            "binaryDir": "${sourceDir}/build/vs2026-x64"
        }
    ],
    "buildPresets": [
        {
            "name": "vs2026-x64-debug",
            "displayName": "Visual Studio 2026 x64 Debug",
            "configurePreset": "vs2026-x64",
            "configuration": "Debug"
        }
    ],
    "testPresets": [
        {
            "name": "vs2026-x64-debug",
            "displayName": "Visual Studio 2026 x64 Debug tests",
            "configurePreset": "vs2026-x64",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
