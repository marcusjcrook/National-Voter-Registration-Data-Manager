{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build ProjectOne (C++26)",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/std:c++latest",
                "/Zc:__cplusplus",
                "/EHsc",
                "/nologo",
                "/Fe${workspaceFolder}\\ProjectOne.exe",
                "${workspaceFolder}\\VoteR4.cpp",
                "${workspaceFolder}\\NvraComparator.cpp",
                "${workspaceFolder}\\NvraRecord.cpp",
                "${workspaceFolder}\\NvraHasher.cpp"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build ProjectOne using MSVC's latest C++ standard mode (C++26)."
        }
    ],
    "version": "2.0.0"
}